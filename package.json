{
  "name": "turing-harness",
  "version": "0.1.0",
  "description": "Coding-agent orchestration library: a categorizer chain (router \u2192 focused categorizer hops \u2192 summary) with per-categorizer toolsets, prompts and orchestrator models, plus per-call model escalation by complexity and category.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tool-titles": {
      "import": "./dist/tool-titles.js",
      "types": "./dist/tool-titles.d.ts"
    },
    "./categorizer-setup": {
      "import": "./dist/categorizer-setup.js",
      "types": "./dist/categorizer-setup.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "keywords": [
    "agent",
    "llm",
    "orchestration",
    "4p",
    "tool-calling"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
